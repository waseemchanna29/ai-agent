# Copy to .env (never share or commit .env).
# Get the token by running `claude setup-token` in your own terminal.
CLAUDE_CODE_OAUTH_TOKEN=

# Trello bridge (see TRELLO.md)
# TRELLO_KEY=
# TRELLO_SECRET=
# TRELLO_TOKEN=                # token of the AGENT Trello account (the one you @mention)
# TRELLO_AUTO_FIX_BUGS=false   # QA bugs → one Trello card each; developer runs only when you mention "dev" on it
# TRELLO_QA_PASS_TO_DONE=true  # QA finds no bugs → card moves to the Done list automatically
# TRELLO_DONE_LIST=Done        # name of that list on your board
# TRELLO_DEV_TO_DOING=true     # developer starts on a card → card moves to the Doing list
# TRELLO_DOING_LIST=Doing      # name of that list on your board
# TRELLO_ROUTER_MODEL=haiku    # small model that picks the agent when your comment doesn't name one
# TRELLO_BRIDGE_PORT=8787
# TRELLO_CALLBACK_URL=https://your-name.ngrok-free.app/trello

# GitHub: developer may branch, commit, push and open PRs (never to main, never force)
# GITHUB_TOKEN=               # fine-grained token: only your repos, Contents + Pull requests = Read and write
# TEAM_GIT_PUSH=true

# Optional
# TEAM_MODEL=opus
# TEAM_MODEL_DOCS=sonnet       # per-agent model (docs defaults to sonnet); also _REQUIREMENTS, _DEVELOPMENT, _QA
# TEAM_EFFORT=high
# TEAM_PERMISSION_MODE=acceptEdits
# TEAM_APPROVAL_GATES=true
