         xsi:noNamespaceSchemaLocation="C:/xampp/htdocs/todo-app/vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="C:/xampp/htdocs/todo-app/vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="QA">
            <file>C:/xampp/htdocs/Agents/agents/qa/projects/todo-app/tests/QaExtraTest.php</file>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
