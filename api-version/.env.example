# Copy this file to .env and fill in your key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
AGENTIC_MODEL=claude-opus-5-5
AGENTIC_EFFORT=high            # low | medium | high | xhigh | max
AGENTIC_MAX_TOKENS=64000
AGENTIC_MAX_TURNS=60           # tool-loop cap per phase
AGENTIC_WORKSPACE=./workspace  # where new projects are created
AGENTIC_COMMAND_MODE=ask       # ask = confirm every shell command; auto = only inside a sandbox/container
AGENTIC_COMMAND_TIMEOUT=300
AGENTIC_APPROVAL_GATES=true
